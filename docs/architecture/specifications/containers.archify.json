  "cards": [
    {
      "dot": "cyan",
      "title": "Application & Contract Containers",
      "items": [
        "Android App provides mobile UI, local offline persistence, and real-time socket sync",
        "Backend Server handles stateless authentication, REST endpoints, and WebSocket sessions",
        "Shared Contract compiles into both containers to enforce identical wire DTOs, error codes, and validations"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data & Messaging Containers",
      "items": [
        "PostgreSQL stores users, refresh tokens, chat rooms, participants, and messages",
        "Redis backs distributed rate-limiting locks and caches recent message slices",
        "RabbitMQ routes asynchronous domain events across internal backend modules"
      ]
    }
  ]
