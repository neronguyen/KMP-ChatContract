  "cards": [
    {
      "dot": "cyan",
      "title": "UUIDv7 Monotonic Sorting & Idempotency",
      "items": [
        "Client generates time-sortable UUIDv7 before network transmission",
        "Backend uses Persistable<UUID> (EntityManager.persist) to avoid accidental merge",
        "Retrying with the same messageId replays the broadcast without duplicate DB rows"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Recovery & State Reconcile",
      "items": [
        "If WS disconnects, markSendingMessagesAsFailed transitions all SENDING to FAILED",
        "Room @Upsert atomically updates local SENDING row to SENT upon server broadcast",
        "Mismatched room/sender for existing messageId returns DuplicateMessageId ErrorCode"
      ]
    }
  ]
