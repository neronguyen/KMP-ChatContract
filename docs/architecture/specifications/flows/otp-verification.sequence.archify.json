  "cards": [
    {
      "dot": "amber",
      "title": "RLock Lease & Concurrency Guard",
      "items": [
        "verifyOtp acquires RLock with a 2-second lease time before checking Redis keys",
        "Serializes concurrent HTTP requests per email:flow to prevent attempt ceiling race bypass",
        "Auto-releases after 2 seconds to guarantee resilience against unhandled node crashes"
      ]
    },
    {
      "dot": "rose",
      "title": "Lockout Threshold & Anti-Enumeration",
      "items": [
        "3 failed verification attempts trigger immediate 5-minute (300s) lockout bucket",
        "Code and attempt keys are deleted immediately upon entering lockout state",
        "Resend endpoints return uniform HTTP 204 No Content to prevent user account enumeration"
      ]
    }
