  "cards": [
    {
      "dot": "amber",
      "title": "Exponential Backoff & Jitter",
      "items": [
        "Formula: min(1000ms * 2^attempt, 30_000ms) + random(0..1000ms)",
        "Attempt counter resets to 0 upon SocketConnectionState.Connected",
        "Superseded sockets isolated by strict object identity checks"
